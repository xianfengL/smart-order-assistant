# Copy this file to .env. Never commit real credentials.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/orders.db
DATA_DIR=data
JWT_SECRET=
ADMIN_PASSWORD=
CUSTOMER_PASSWORD=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Required when DEMO_MODE=false; set a model available to your provider.
LLM_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
# stdio uses the included real MCP server; local uses the same converter directly.
CHART_TRANSPORT=stdio
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
